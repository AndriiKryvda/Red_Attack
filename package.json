{
  "name": "red-attack",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "preinstall": "node scripts/check-engines.js",
    "dev": "npm run build:shared && concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd packages/server && npm run dev",
    "dev:client": "cd packages/client && npm run dev",
    "build": "npm run build:shared && npm run build:server && npm run build:client",
    "build:shared": "cd packages/shared && npm run build",
    "build:server": "cd packages/server && npm run build",
    "build:client": "cd packages/client && npm run build",
    "start": "cd packages/server && node dist/index.js",
    "start:all": "concurrently -n server,client \"npm run start\" \"npm run preview:client\"",
    "preview:client": "cd packages/client && npm run preview -- --host 0.0.0.0 --port 5173",
    "bench:net": "node scripts/netbench.mjs",
    "test:net": "tsx scripts/netroundtrip.mts"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.5.0"
  }
}
